# PostgreSQL connection string (Neon / Railway / Render / local docker)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/college_discovery?schema=public"

# Non-pooled connection used for migrations (Neon/Supabase). Same as DATABASE_URL locally.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/college_discovery?schema=public"

# Shared secret required by write endpoints that mutate curated data (ingestion).
ADMIN_API_KEY="dev-admin-key-change-me"

NODE_ENV="development"
